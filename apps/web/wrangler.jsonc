{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "occavoy-web",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true }
  },
  "vars": {
    "CUSTOMER_MARKET": "HK",
    "DESTINATION_SCOPE": "global",
    "R2_CAPACITY_BYTES": "8000000000",
    "UPLOADS_ENABLED": "false"
  },
  "env": {
    "dev": {
      "name": "occavoy-web-dev",
      "vars": {
        "CUSTOMER_MARKET": "HK",
        "DESTINATION_SCOPE": "global",
        "R2_CAPACITY_BYTES": "8000000000",
        "UPLOADS_ENABLED": "false"
      },
      "r2_buckets": [
        {
          "binding": "OCCAVOY_EVIDENCE",
          "bucket_name": "occavoy-dev-evidence"
        }
      ],
      "secrets": { "required": ["OCCAVOY_WEB_CASE_GRANT_SIGNING_SECRET"] }
    }
  }
  // R2 is evidence storage only. The application quota remains 8,000,000,000 bytes
  // across Occavoy-managed environments; a binding is not a native account quota.
}
