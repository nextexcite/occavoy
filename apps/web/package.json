{
  "name": "@occavoy/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=dev vite --host 127.0.0.1 --port 3000",
    "build": "CLOUDFLARE_ENV=dev vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "deploy": "pnpm build && wrangler deploy",
    "cf:typegen": "wrangler types --env dev --include-runtime false --strict-vars false"
  },
  "dependencies": {
    "@occavoy/domain": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.2",
    "@cloudflare/workers-types": "5.20261127.1",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.4.0",
    "wrangler": "4.168.0"
  }
}
