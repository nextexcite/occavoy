# Local only. Generate a private token; never commit it or ship it in client JS.
OCCAVOY_RUNTIME_MODE=local
OCCAVOY_RUNTIME_DEMO_TOKEN=
PORT=8080

# Rivet Cloud injects RIVET_ENDPOINT, RIVET_TOKEN and RIVET_POOL into hosted nodes.
# Set OCCAVOY_RUNTIME_MODE=cloud and the demo token as a cluster secret there.
