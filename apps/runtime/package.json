{
  "name": "@occavoy/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "pnpm build && node --test test/*.test.mjs",
    "verify:live": "node test/verify-live.mjs",
    "verify:restart": "pnpm build && node test/verify-restart.mjs"
  },
  "dependencies": {
    "rivetkit": "3.1.1"
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
