# Copy only to an ignored local .env. Never paste credentials into issues or docs.
RIVET_ENDPOINT=
RIVET_TOKEN=
RIVET_ORG=
RIVET_CLUSTER=
OCCAVOY_RUNTIME_MODE=local
# Required for the isolated runtime probe; generate locally, never commit a value.
OCCAVOY_RUNTIME_DEMO_TOKEN=
DATABASE_URL=
# Optional explicit opt-in for disposable database-backed tests; not part of the fnox local profile.
OCCAVOY_TEST_DATABASE_URL=
R2_CAPACITY_BYTES=8000000000
# Provider is intentionally unconfigured until a workload needs isolation.
SANDBOX_PROVIDER=disabled
E2B_API_KEY=
